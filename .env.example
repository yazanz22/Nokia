# ── FILO Asset Sentinel — environment ─────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored.

# ── Nokia Network as Code (CAMARA) ───────────────────────────────────────────
# NAC_MODE: "mock" (dataset-backed, no network) | "live" (real sandbox calls, mock-on-error fallback)
NAC_MODE=mock
# Application Key from the Nokia Network as Code console (authorization method: RAPIDAPI).
NAC_API_KEY=
# Optional map of device_id -> sandbox MSISDN. Works for assets AND technicians —
# a technician's phone is a device on the same network, so Location Retrieval finds
# whoever is genuinely nearest rather than trusting a roster. In live mode only
# technicians listed here are located; the rest keep their last known position, so
# they do not all collapse onto the shared sandbox device. e.g.
#   EQ-0180:+99999991000,TECH-01:+99999991001,TECH-02:+99999991002
NAC_DEVICE_MAP=
# The sandbox issues far fewer test devices than we have assets. Any asset without an
# explicit mapping uses this one, so every call stays genuinely live.
NAC_DEFAULT_DEVICE=+99999991000
# Transport (verified 2026-09-01). Leave these unless Nokia changes the sandbox.
NAC_API_HOST=network-as-code.p-eu.apihub.nokia.io
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_TIMEOUT_SECONDS=20

# ── AI agent layer ──────────────────────────────────────────────────────────
# AGENT_MODE: "rule" (deterministic, no LLM) | "llm" (Pydantic AI + LLM_MODEL)
AGENT_MODE=rule
# Pydantic AI model string. Must support tool calling.
# Verified working on the Groq free tier: groq:openai/gpt-oss-120b (open weights,
# served by Groq) and groq:qwen/qwen3.8-27b — both confirmed against the models
# endpoint and exercised with a real tool call. groq/compound does NOT support tools.
# Further tools-capable options on the same key, should both of the above degrade:
# groq:qwen/qwen3.6-27b, groq:openai/gpt-oss-20b.
# Check what your key can reach: GET https://api.groq.com/openai/v1/models
# (each model's "supported_features" lists "tools" when it can call them)
LLM_MODEL=groq:openai/gpt-oss-120b
# Concurrent LLM investigations. Keep low: Groq's free tier is 8000 tokens/min and
# exceeding it makes the agent fall back to the deterministic path mid-demo.
AGENT_MAX_CONCURRENT=1
GROQ_API_KEY=
GEMINI_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# The absolute public URL this deployment answers on, e.g.
# https://filo-asset-sentinel.onrender.com — scheme required, trailing slash optional.
# The only thing built from it is the callback sink handed to the operator when
# registering a CAMARA geofencing subscription, and that must come from
# configuration rather than from the request's Host header: the live-check endpoint
# is open, and a caller who could choose the sink could point a subscription made on
# our Nokia credentials at their own server. Leave it empty on localhost — the
# perimeter watch is then simply not registered and the panel says so, which is the
# same thing the operator would tell us about a callback it cannot reach.
PUBLIC_BASE_URL=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Telemetry simulator tick interval (seconds)
SIM_TICK_SECONDS=2.0
# Seconds without telemetry before an asset is flagged "silent"
SILENT_THRESHOLD_SECONDS=30
# "Now" for the predictive-maintenance view. Telemetry history replays up to this
# instant, so the fleet shows a mix of healthy and mid-degradation machines.
FORECAST_AS_OF=2026-08-18T06:00:00
# Seconds before a dispatched job completes, freeing the technician and bringing the
# machine back online. Demo time compression — the real figure is the work order ETA.
WORK_ORDER_COMPLETE_SECONDS=90
# Wall-clock seconds a machine parked in a cellular blind spot waits before the agent's
# promised automated re-check actually fires. Real operations would wait ~15 minutes; a
# roaming ticket, which the agent schedules at 30, waits double this. Demo time
# compression again — and the interval printed in the incident resolution is whatever
# this produces, so the text and the behaviour cannot drift apart.
RECHECK_AFTER_SECONDS=45
# Number of assets in the live demo fleet (subset of the 500 in the dataset)
DEMO_FLEET_SIZE=30
# Serve /docs, /redoc and /openapi.json. Deliberately on: the generated reference is
# how a judge inspects the CAMARA surface without reading the source, and it exposes
# no secret — every route it describes answers to plain curl either way, and the
# mutating ones are unauthenticated by design (scenario injection is rate-limited,
# reset is a button on the dashboard). So the exposure is those routes, not their
# documentation. Set DOCS_ENABLED=0 the day this URL outlives the hackathon.
DOCS_ENABLED=1
# How many dashboard websockets the event bus will carry at once. The deployed demo is
# one public URL with no authentication, so the listener count is whatever the internet
# decides — and each listener costs a 1000-slot queue, a full fleet snapshot on connect
# and a slot in every fan-out. On a 512MB instance a shared link or a reconnect storm
# would otherwise walk the process into the OOM killer. Past this many the bus refuses
# with close code 1013 and the dashboard retries with backoff, so nobody already
# watching degrades. Raise it if you give the instance more memory.
MAX_WS_SUBSCRIBERS=32
