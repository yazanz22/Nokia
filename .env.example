# ── FILO Asset Sentinel — environment ─────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored.

# ── Nokia Network as Code (CAMARA) ───────────────────────────────────────────
# NAC_MODE: "mock" (dataset-backed, no network) | "live" (real sandbox calls, mock-on-error fallback)
NAC_MODE=mock
# Application Key from the Nokia Network as Code console (authorization method: RAPIDAPI).
NAC_API_KEY=
# Optional per-asset map of asset_id -> sandbox MSISDN, e.g.
#   EQ-0180:+99999991000,EQ-0295:+99999991001
NAC_DEVICE_MAP=
# The sandbox issues far fewer test devices than we have assets. Any asset without an
# explicit mapping uses this one, so every call stays genuinely live.
NAC_DEFAULT_DEVICE=+99999991000
# Transport (verified 2026-09-01). Leave these unless Nokia changes the sandbox.
NAC_API_HOST=network-as-code.p-eu.apihub.nokia.io
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_TIMEOUT_SECONDS=20

# ── AI agent layer ──────────────────────────────────────────────────────────
# AGENT_MODE: "rule" (deterministic, no LLM) | "llm" (Pydantic AI + LLM_MODEL)
AGENT_MODE=rule
# Pydantic AI model string. Must support tool calling.
# Verified working on the Groq free tier: groq:openai/gpt-oss-120b (open weights,
# served by Groq) and groq:qwen/qwen3.8-27b. groq/compound does NOT support tools.
# Check what your key can reach: GET https://api.groq.com/openai/v1/models
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Telemetry simulator tick interval (seconds)
SIM_TICK_SECONDS=2.0
# Seconds without telemetry before an asset is flagged "silent"
SILENT_THRESHOLD_SECONDS=30
# Number of assets in the live demo fleet (subset of the 500 in the dataset)
DEMO_FLEET_SIZE=30
