# ── FILO Asset Sentinel — environment ─────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored.

# ── Nokia Network as Code (CAMARA) ───────────────────────────────────────────
# NAC_MODE: "mock" (dataset-backed, no network) | "live" (real sandbox calls, mock-on-error fallback)
NAC_MODE=mock
NAC_API_KEY=
# Comma-separated map of asset_id -> sandbox device phone number, e.g.
#   EQ-0007:+3197010000001,EQ-0042:+3197010000002
NAC_DEVICE_MAP=
# Sandbox base URL (leave default unless Nokia tells you otherwise)
NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com

# ── AI agent layer ──────────────────────────────────────────────────────────
# AGENT_MODE: "rule" (deterministic, no LLM) | "llm" (Pydantic AI + LLM_MODEL)
AGENT_MODE=rule
# Pydantic AI model string. Examples:
#   groq:llama-3.3-70b-versatile   google-gla:gemini-2.0-flash   openai:gpt-4o-mini (via local Ollama proxy)
LLM_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Telemetry simulator tick interval (seconds)
SIM_TICK_SECONDS=2.0
# Seconds without telemetry before an asset is flagged "silent"
SILENT_THRESHOLD_SECONDS=30
# Number of assets in the live demo fleet (subset of the 500 in the dataset)
DEMO_FLEET_SIZE=30
